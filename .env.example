# Groq API
GROQ_API_KEY=your_groq_api_key_here

# Model Configuration
LLM_MODEL=llama-3.3-70b-versatile
GUARDRAIL_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Audio Processing
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Diarization (IMPORTANT: Get token from https://huggingface.co/settings/tokens)
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Security - JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here_use_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Demo Physician Credentials (Pre-hashed with bcrypt)
DR_SHARMA_PASSWORD_HASH=your_bcrypt_hash_here
DR_SHARMA_NAME=Dr. Priya Sharma
DR_SHARMA_DEPARTMENT=General Medicine

DR_KUMAR_PASSWORD_HASH=your_bcrypt_hash_here
DR_KUMAR_NAME=Dr. Rahul Kumar
DR_KUMAR_DEPARTMENT=Cardiology

DR_PATEL_PASSWORD_HASH=your_bcrypt_hash_here
DR_PATEL_NAME=Dr. Anjali Patel
DR_PATEL_DEPARTMENT=Endocrinology

# File Upload Limits
MAX_AUDIO_SIZE_MB=50
MAX_PDF_SIZE_MB=10

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Confidence Thresholds
CONFIDENCE_HIGH=0.85
CONFIDENCE_MEDIUM=0.70
