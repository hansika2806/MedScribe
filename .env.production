# MedScribe Production Environment Configuration
# IMPORTANT: Copy this to .env and fill in all values before deployment

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
POSTGRES_DB=medscribe
POSTGRES_USER=medscribe_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!@#

# Database URL (auto-constructed in docker-compose)
DATABASE_URL=postgresql+asyncpg://medscribe_user:CHANGE_THIS_STRONG_PASSWORD_123!@#@postgres:5432/medscribe

# ============================================================================
# API KEYS (Required)
# ============================================================================
# Get from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================
LLM_MODEL=openai/gpt-oss-120b
GUARDRAIL_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# ============================================================================
# SECURITY CONFIGURATION (CRITICAL - CHANGE ALL VALUES)
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_THIS_TO_FERNET_KEY

# ============================================================================
# PHYSICIAN CREDENTIALS (Pre-hashed with bcrypt)
# ============================================================================
# Generate with: python backend/generate_hashes.py
# Default password for all: medscribe123 (CHANGE IN PRODUCTION!)
DR_SHARMA_PASSWORD_HASH=$2b$12$BeOql6GBc5PJPBtNSjmsduHC.IP88cA4AjnryHi2b5bF6J6xhfEaS
DR_SHARMA_NAME=Dr. Priya Sharma
DR_SHARMA_DEPARTMENT=General Medicine

DR_KUMAR_PASSWORD_HASH=$2b$12$a/D6zj7jXoARRcL0KbC1GO52G84jvb0oJmZt58xubhDSDpA2PfMYq
DR_KUMAR_NAME=Dr. Rahul Kumar
DR_KUMAR_DEPARTMENT=Cardiology

DR_PATEL_PASSWORD_HASH=$2b$12$8YMG7lm28tWJdU8HMhnh4eBJH7BZvOVZah.718h7xOWFU5WG2F18m
DR_PATEL_NAME=Dr. Anjali Patel
DR_PATEL_DEPARTMENT=Endocrinology

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# CORS - Update with your actual domain in production
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# FILE UPLOAD LIMITS
# ============================================================================
MAX_AUDIO_SIZE_MB=50
MAX_PDF_SIZE_MB=10

# ============================================================================
# CONFIDENCE THRESHOLDS
# ============================================================================
CONFIDENCE_HIGH=0.85
CONFIDENCE_MEDIUM=0.70

# ============================================================================
# SSL/TLS CONFIGURATION (for production with nginx-proxy)
# ============================================================================
SSL_CERTIFICATE_PATH=/etc/nginx/ssl/cert.pem
SSL_CERTIFICATE_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_DHPARAM_PATH=/etc/nginx/ssl/dhparam.pem

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=medscribe-backups
BACKUP_S3_REGION=us-east-1

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
LOG_LEVEL=INFO
SENTRY_DSN=  # Optional: Add Sentry DSN for error tracking
ENABLE_METRICS=true
METRICS_PORT=9090